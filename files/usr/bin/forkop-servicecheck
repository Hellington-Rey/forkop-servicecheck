#!/bin/sh

# POSIX shell wrapper for the ucode probe engine. Do not use an absolute ucode
# shebang: OpenWrt builds may expose ucode through PATH at another location.

LIB_DIR="${FORKOP_SC_LIB:-/usr/lib/forkop-servicecheck}"
ENGINE="$LIB_DIR/probe.uc"
BIN_PATH="/usr/bin/forkop-servicecheck"

show_help() {
    cat <<EOF
Usage: $BIN_PATH COMMAND [ARGS]

Available commands:
    list                    Показать доступные профили сервисов
    capabilities            Показать возможности роутера (curl, dig, netns, fakeip)
    custom HOST [PORT] [MODE] [IP]
                            Проверить любой IPv4/домен и маршрут через sing-box
    run IDS [MODE] [IP]     Проверить сервисы синхронно и напечатать JSON
    start IDS [MODE] [IP]   Запустить проверку в фоне, вернуть job_id
    status JOB_ID           Показать состояние фоновой проверки
    cleanup                 Удалить устаревшие задания
    fixes                   Показать разрешённые исправления Forkop
    fix ID                  Применить исправление Forkop из белого списка
    profiles-get            Показать активный список проверок
    profiles-save JSON      Проверить и сохранить пользовательский список
    profiles-reset          Вернуться к встроенному списку
    netns_teardown          Снести временный network namespace

IDS  - список id сервисов через запятую либо 'all'
MODE - router (по умолчанию) или netns
IP   - желаемый адрес клиента для режима netns

Примеры:
    $BIN_PATH custom example.com 443 router
    $BIN_PATH run telegram,youtube
    $BIN_PATH run all netns
EOF
}

COMMAND="${1:-}"
case "$COMMAND" in
    "") show_help; exit 1 ;;
    -h|--help|help) show_help; exit 0 ;;
esac

[ -f "$ENGINE" ] || {
    echo "Error: engine '$ENGINE' is missing" >&2
    exit 1
}
command -v ucode >/dev/null 2>&1 || {
    echo "Error: ucode is not installed or is not available in PATH" >&2
    exit 1
}

case "$COMMAND" in
    list|capabilities|fixes|cleanup|profiles-get|profiles-reset)
        exec ucode -L "$LIB_DIR" "$ENGINE" "$COMMAND"
        ;;
    fix|status|profiles-save)
        exec ucode -L "$LIB_DIR" "$ENGINE" "$COMMAND" "${2:-}"
        ;;
    custom)
        exec ucode -L "$LIB_DIR" "$ENGINE" custom "${2:-}" "${3:-}" "${4:-}" "${5:-}"
        ;;
    run|start)
        exec ucode -L "$LIB_DIR" "$ENGINE" "$COMMAND" "${2:-}" "${3:-}" "${4:-}"
        ;;
    xhttp_patch)
        exec ucode -L "$LIB_DIR" "$ENGINE" xhttp-patch
        ;;
    icmp_tproxy_patch)
        exec ucode -L "$LIB_DIR" "$ENGINE" icmp-tproxy-patch
        ;;
    netns_teardown)
        exec ucode -L "$LIB_DIR" "$ENGINE" netns-teardown
        ;;
    *)
        echo "Error: unknown command '$COMMAND'" >&2
        echo >&2
        show_help >&2
        exit 1
        ;;
esac
